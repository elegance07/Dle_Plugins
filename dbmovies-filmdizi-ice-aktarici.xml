if (!defined('DATALIFEENGINE')) {
    die("Hacking attempt!");
}

// Ayarları yükle
include_once DLEPlugins::Check(ENGINE_DIR . '/data/dbmovies.config.php');

// Film listesi gösterme fonksiyonu
function show_movies() {
    global $db, $tmdb_config;

    $movies = $db->query("SELECT * FROM " . PREFIX . "_post WHERE category = '{$tmdb_config['movie_category']}' ORDER BY date DESC");

    while ($movie = $db->get_row($movies)) {
        echo "<div class='movie'>";
        echo "<h2>{$movie['title']}</h2>";
        echo "<p>{$movie['short_story']}</p>";
        echo "</div>";
    }
}

// Film detayları gösterme fonksiyonu
function show_movie_details($id) {
    global $db;

    $movie = $db->super_query("SELECT * FROM " . PREFIX . "_post WHERE id = '{$id}'");

    if ($movie) {
        echo "<div class='movie-details'>";
        echo "<h2>{$movie['title']}</h2>";
        echo "<p>{$movie['full_story']}</p>";
        echo "</div>";
    } else {
        echo "Film bulunamadı.";
    }
}
?>]]></replacecode>
