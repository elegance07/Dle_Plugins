// TMDb API fonksiyonları
function tmdb_request($endpoint, $params = []) {
    global $tmdb_config;

    // API anahtarını kontrol et
    if (empty($tmdb_config['api_key'])) {
        die(json_encode(['status' => 'error', 'message' => 'API anahtarı bulunamadı.']));
    }

    $api_key = $tmdb_config['api_key'];
    $base_url = 'https://api.themoviedb.org/3';
    $params['api_key'] = $api_key;

    $url = $base_url . $endpoint . '?' . http_build_query($params);

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    $response = curl_exec($ch);
    curl_close($ch);

    return json_decode($response, true);
}

// Gelen aksiyonu al
$action = $_POST['action'] ?? '';

switch ($action) {
    case 'search':
        if (!isset($_POST['query']) || !isset($_POST['type'])) {
            die(json_encode([
                'status' => 'error', 
                'message' => 'Eksik parametreler gönderildi.'
            ]));
        }

        $query = trim($_POST['query']);
        $type = $_POST['type'];

        if ($type != 'movie' && $type != 'tv') {
            die(json_encode([
                'status' => 'error', 
                'message' => 'Geçersiz içerik türü'
            ]));
        }

        // TMDb API'sine istek yap
        $results = tmdb_request('/search/' . $type, [
            'query' => $query,
            'language' => $tmdb_config['default_language']
        ]);

        if (isset($results['results'])) {
            die(json_encode([
                'status' => 'success', 
                'results' => $results['results']
            ]));
        } else {
            die(json_encode([
                'status' => 'error', 
                'message' => 'API hatası: ' . json_encode($results)
            ]));
        }
        break;

    default:
        die(json_encode(['status' => 'error', 'message' => 'Geçersiz işlem']));
}
?>]]></replacecode>
