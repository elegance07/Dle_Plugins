<script type="text/javascript">
var dle_root = '<?php echo $config['http_home_url']; ?>';
var dle_login_hash = '<?php echo $dle_login_hash; ?>';

function searchMovies() {
    var query = $('#movie_search').val();
    var type = $('#content_type').val(); // Film veya dizi seçimi

    $.ajax({
        url: "engine/ajax/controller.php?mod=movies",
        method: "POST",
        data: {
            action: "search",
            query: query,
            type: type,
            user_hash: dle_login_hash
        },
        success: function(response) {
            console.log(response); // Yanıtı konsola yazdır
            try {
                var data = JSON.parse(response); // JSON'u ayrıştır
                if (data.status === 'success') {
                    var results = data.results;
                    var html = '';

                    // JSON yanıtını HTML'e dönüştür
                    results.forEach(function(movie) {
                        var releaseYear = movie.release_date ? movie.release_date.split('-')[0] : 'Bilinmiyor';
                        var posterPath = movie.poster_path ? 'https://image.tmdb.org/t/p/w500' + movie.poster_path : 'https://via.placeholder.com/200x300?text=Resim+Yok';
                        html += '<div class="movie-card">';
                        html += '<img src="' + posterPath + '" alt="' + movie.title + '">';
                        html += '<h3>' + movie.title + '</h3>';
                        html += '<p>' + releaseYear + '</p>';
                        html += '<button class="btn btn-primary" onclick="addMovie(' + movie.id + ')">Ekle</button>';
                        html += '</div>';
                    });

                    // HTML içeriğini sayfaya ekle
                    $('#search_results').html(html);
                } else {
                    // Hata mesajını göster
                    var errorMessage = data.message || 'Bilinmeyen hata';
                    DLEalert("Film aranırken hata oluştu: " + errorMessage, "error");
                }
            } catch (e) {
                console.error("JSON ayrıştırma hatası:", e); // JSON ayrıştırma hatası
                DLEalert("Yanıt işlenirken hata oluştu.", "error");
            }
        },
        error: function(xhr, status, error) {
            console.error(xhr.responseText); // Hata mesajını konsola yazdır
            DLEalert("AJAX hatası: " + error, "error");
        }
    });
}
function loadDiscover() {
    var sort = $('#sort_by').val();
    $.ajax({
        url: "engine/ajax/controller.php?mod=movies", // Bu satırı düzeltin
        method: "POST",
        data: {
            action: "discover",
            sort_by: sort,
            user_hash: dle_login_hash
        },
        success: function(response) {
            $('#discover_results').html(response);
        }
    });
}

function addMovie(tmdb_id) {
    $.ajax({
        url: "engine/ajax/controller.php?mod=movies",
        method: "POST",
        data: {
            action: "import",
            id: tmdb_id,
            type: "movie",
            user_hash: dle_login_hash
        },
        success: function(response) {
            if (response.status === 'success') {
                DLEalert("Film başarıyla eklendi!", "success");
            } else {
                DLEalert("Film eklenirken hata oluştu: " + response.message, "error");
            }
        }
    });
}
$('#settingsForm').on('submit', function(e) {
    e.preventDefault(); // Sayfa yenilenmesini engelle
    var formData = $(this).serialize(); // Form verilerini al
    formData += '&action=save_settings&user_hash=' + dle_login_hash; // Ek parametreler ekle

    $.ajax({
        url: "engine/ajax/controller.php?mod=movies", // Bu satırı düzeltin
