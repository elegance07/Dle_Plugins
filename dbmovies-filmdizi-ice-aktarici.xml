error_reporting(E_ALL);
ini_set('display_errors', 1);

if (!defined('DATALIFEENGINE')) {
    header("HTTP/1.1 403 Forbidden");
    header('Location: ../../');
    die("Hacking attempt!");
}

// Ayarları yükle
include_once DLEPlugins::Check(ENGINE_DIR . '/data/dbmovies.config.php');

// Kullanıcı yetkilerini kontrol et
if ($member_id['user_group'] != 1) {
    die(json_encode(['status' => 'error', 'message' => $lang['index_denied']]));
}

// Kullanıcı hash kontrolü
if (!isset($_REQUEST['user_hash']) || $_REQUEST['user_hash'] != $dle_login_hash) {
    die(json_encode(['status' => 'error', 'message' => 'Invalid user hash!']));
